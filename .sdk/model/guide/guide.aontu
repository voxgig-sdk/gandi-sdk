# "List record types".
guide: entity: livedns_rrtype: path: "/livedns/dns/rrtypes": op: list: method: GET


# LINKED ZONE. The zone keeps the heuristic's entity. "Deploy or undeploy a
# zone" posts to the zone's own route, so it is an entity of its own.
guide: entity: linked_zone: path: "/linkedzone/zones/{zone_id}": op: create: active: false
guide: entity: linked_zone: path: "/linkedzone/domains": active: false
guide: entity: linked_zone: path: "/linkedzone/domains/{domain}": active: false
guide: entity: linked_zone: path: "/linkedzone/tasks": active: false
guide: entity: linked_zone: path: "/linkedzone/tasks/{task_id}": active: false
guide: entity: linked_zone: path: "/linkedzone/unlink/domains": active: false
guide: entity: linked_zone: path: "/linkedzone/zones/{zone_id}/link/domains": active: false

guide: entity: linked_zone_deployment: path: "/linkedzone/zones/{zone_id}": op: create: method: POST

# Domains, named by `name`, with linking and unlinking as actions.
guide: entity: linked_zone_domain: path: "/linkedzone/domains": op: list: method: GET
guide: entity: linked_zone_domain: path: "/linkedzone/domains/{domain}": {
  rename: param: domain: name
  op: load: method: GET
}
guide: entity: linked_zone_domain: path: "/linkedzone/zones/{zone_id}/link/domains": {
  action: link: {}
  op: patch: method: PATCH
}
guide: entity: linked_zone_domain: path: "/linkedzone/unlink/domains": {
  action: unlink: {}
  op: patch: method: PATCH
}

guide: entity: linked_zone_task: path: "/linkedzone/tasks": op: list: method: GET
guide: entity: linked_zone_task: path: "/linkedzone/tasks/{task_id}": {
  rename: param: task_id: id
  op: load: method: GET
}


# CERTIFICATE. Issued certificates. "Renew a certificate" posts to the
# certificate's own route, so it is an entity of its own.
guide: entity: issued_certificate: path: "/certificate/issued-certs": {
  op: list: method: GET
  op: create: method: POST
}
guide: entity: issued_certificate: path: "/certificate/issued-certs/{id}": {
  op: load: method: GET
  op: patch: method: PATCH
  op: remove: method: DELETE
}
# "Retrieve certificate" answers with the PEM text.
guide: entity: issued_certificate: path: "/certificate/issued-certs/{id}/crt": {
  action: crt: {}
  op: load: method: GET
}
# Domain control validation: "Resend the DCV" is the update, "Update the
# DCV method" the patch. On the certificate both would be actions of one
# route, and the SDK could only ever choose one of them.
guide: entity: certificate_dcv: path: "/certificate/issued-certs/{id}/dcv": {
  rename: param: id: certificate_id
  op: update: method: PUT
  op: patch: method: PATCH
}
# "Retrieve DCV parameters", for an issued certificate or before ordering.
guide: entity: issued_certificate: path: "/certificate/issued-certs/{id}/dcv_params": {
  action: dcv_params: {}
  op: create: method: POST
}
guide: entity: issued_certificate: path: "/certificate/dcv_params": {
  action: dcv_params: {}
  op: create: method: POST
}

guide: entity: certificate_renewal: path: "/certificate/issued-certs/{id}": {
  rename: param: id: certificate_id
  op: create: method: POST
}

guide: entity: certificate_tag: path: "/certificate/issued-certs/{id}/tags": {
  rename: param: id: certificate_id
  op: list: method: GET
  op: create: method: POST
  op: update: method: PUT
  op: patch: method: PATCH
  op: remove: method: DELETE
}

guide: entity: certificate_package: path: "/certificate/packages": op: list: method: GET
guide: entity: certificate_package: path: "/certificate/packages/{name}": op: load: method: GET

# Intermediate certificates, by type or by file name, as PEM text.
guide: entity: certificate_pem: path: "/certificate/pem/{type}": op: load: method: GET
guide: entity: certificate_pem: path: "/certificate/pem/-/{filename}": op: load: method: GET


