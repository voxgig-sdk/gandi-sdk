  action: config: {}
  op: load: method: GET
}
guide: entity: livedns_axfr_tsig: path: "/livedns/domains/{fqdn}/axfr/tsig": op: list: method: GET
guide: entity: livedns_axfr_tsig: path: "/livedns/domains/{fqdn}/axfr/tsig/{id}": {
