# Guide

@"@voxgig/apidef/model/guide.aontu"

@"./base-guide.aontu"


# GANDI'S OWN RESOURCES. The definition has no named schemas, so the
# heuristic grouped the 221 operations by documentation section: one entity
# per section, with each section's routes competing for the same few
# selectors (26 warnings, and most routes unreachable). Below, each route is
# declared on the resource it manages.
#
# Conventions:
# - A route parameter keeps Gandi's name, or takes the name of the field that
#   carries the same value in the answer, so that a loaded record can be
#   updated or removed as it stands: a domain's {domain} is its `fqdn`, a
#   mailbox's {email} its `address`.
# - The SDK tries the most specific route first. Operations that act on a
#   whole collection at once (renewing every mailbox, purging a mailbox,
#   every record of one name) are actions, selected with `$action`, so that
#   leaving a parameter out can never select them. Replacing or deleting
#   every record of a zone is the entity `livedns_zone`.
# - Verbs on a resource are actions on it: `domain.update({ fqdn, $action:
#   'authinfo' })` resets a domain's authorization code.
# - A POST to an item's own route that does not create the item (renew a
#   certificate, deploy a linked zone, apply a template) is its own entity,
#   so that a create can never select it.


# SECTIONS WHOSE ENTITY IS REPLACED WHOLE.
guide: entity: acme: active: false
guide: entity: billing: active: false
guide: entity: certificate: active: false
guide: entity: email: active: false
guide: entity: live_dn: active: false
guide: entity: nt: active: false
guide: entity: web_hosting: active: false


# DOMAIN. The domain itself: list, register, details, delete, and the verbs
# Gandi documents on a domain. Its {domain} is the domain name, which the
# answer carries as `fqdn`.
guide: entity: domain: path: "/domain/domains/{domain}": rename: param: domain: fqdn
guide: entity: domain: path: "/domain/domains/{domain}/authinfo": rename: param: domain: fqdn
guide: entity: domain: path: "/domain/domains/{domain}/autorenew": rename: param: domain: fqdn
guide: entity: domain: path: "/domain/domains/{domain}/createstatus": rename: param: domain: fqdn
guide: entity: domain: path: "/domain/domains/{domain}/reachability": rename: param: domain: fqdn
guide: entity: domain: path: "/domain/domains/{domain}/status": rename: param: domain: fqdn
guide: entity: domain: path: "/domain/domains/{domain}/transferout": rename: param: domain: fqdn

# "Domain renewal information" and "Domain restore information" answer with
# one record each, not a list.
guide: entity: domain: path: "/domain/domains/{domain}/renew": {
  rename: param: domain: fqdn
  op: list: active: false
  op: load: method: GET
}
guide: entity: domain: path: "/domain/domains/{domain}/restore": {
  rename: param: domain: fqdn
  op: list: active: false
  op: load: method: GET
}

# Routes below a domain that manage something of their own move to that
# resource.
guide: entity: domain: path: "/domain/changeowner/{domain}": active: false
guide: entity: domain: path: "/domain/changeowner/{domain}/foa": active: false
guide: entity: domain: path: "/domain/check": active: false
guide: entity: domain: path: "/domain/domains/{domain}/claims": active: false
guide: entity: domain: path: "/domain/domains/{domain}/contacts": active: false
guide: entity: domain: path: "/domain/domains/{domain}/contacts/owner": active: false
guide: entity: domain: path: "/domain/domains/{domain}/dnskeys": active: false
guide: entity: domain: path: "/domain/domains/{domain}/dnskeys/{id}": active: false
guide: entity: domain: path: "/domain/domains/{domain}/hosts": active: false
guide: entity: domain: path: "/domain/domains/{domain}/hosts/{name}": active: false
guide: entity: domain: path: "/domain/domains/{domain}/livedns": active: false
guide: entity: domain: path: "/domain/domains/{domain}/livedns/dnssec": active: false
guide: entity: domain: path: "/domain/domains/{domain}/nameservers": active: false
guide: entity: domain: path: "/domain/domains/{domain}/tags": active: false
guide: entity: domain: path: "/domain/domains/{domain}/webredirs": active: false
guide: entity: domain: path: "/domain/domains/{domain}/webredirs/{host}": active: false
guide: entity: domain: path: "/domain/tlds": active: false
guide: entity: domain: path: "/domain/tlds/{name}": active: false
guide: entity: domain: path: "/domain/transferin": active: false
guide: entity: domain: path: "/domain/transferin/{domain}": active: false
guide: entity: domain: path: "/domain/transferin/{domain}/authinfo": active: false
guide: entity: domain: path: "/domain/transferin/{domain}/available": active: false
guide: entity: domain: path: "/domain/transferin/{domain}/foa": active: false

# "Domain availability": one answer with the products, prices and taxes.
guide: entity: domain_availability: path: "/domain/check": op: load: method: GET

# "List available TLD extensions" and "TLD Details".
guide: entity: tld: path: "/domain/tlds": op: list: method: GET
guide: entity: tld: path: "/domain/tlds/{name}": op: load: method: GET

# "Retrieve potential trademark information" and "Accept a previously
# retrieved claims".
guide: entity: domain_claim: path: "/domain/domains/{domain}/claims": {
  op: load: method: GET
  op: create: method: POST
}

# "Domain contact list" and "Domain contact update": one record per domain.
# "Edit domain owner" is an action on it.
guide: entity: domain_contact: path: "/domain/domains/{domain}/contacts": {
  op: load: method: GET
  op: patch: method: PATCH
}
guide: entity: domain_contact: path: "/domain/domains/{domain}/contacts/owner": {
  action: owner: {}
  op: update: method: PUT
}

# DNSSEC keys at the registry. "Replace keys on this domain" is the only
# update, and replaces the whole set.
guide: entity: domain_dnskey: path: "/domain/domains/{domain}/dnskeys": {
  op: list: method: GET
  op: create: method: POST
  op: update: method: PUT
}
guide: entity: domain_dnskey: path: "/domain/domains/{domain}/dnskeys/{id}": op: remove: method: DELETE

# Glue records, named by host name.
guide: entity: domain_host: path: "/domain/domains/{domain}/hosts": {
  op: list: method: GET
  op: create: method: POST
}
guide: entity: domain_host: path: "/domain/domains/{domain}/hosts/{name}": {
  op: load: method: GET
  op: update: method: PUT
  op: remove: method: DELETE
}

# Web redirections, named by host.
guide: entity: domain_webredir: path: "/domain/domains/{domain}/webredirs": {
  op: list: method: GET
  op: create: method: POST
}
guide: entity: domain_webredir: path: "/domain/domains/{domain}/webredirs/{host}": {
  op: load: method: GET
  op: patch: method: PATCH
  op: remove: method: DELETE
}

# The domain's nameservers: a list of host names, replaced as a whole.
guide: entity: domain_nameserver: path: "/domain/domains/{domain}/nameservers": {
  op: list: method: GET
  op: update: method: PUT
}

# The domain's tags: a list of strings. Update replaces them all, patch
# changes some, remove removes them all.
guide: entity: domain_tag: path: "/domain/domains/{domain}/tags": {
  op: list: method: GET
  op: create: method: POST
  op: update: method: PUT
  op: patch: method: PATCH
  op: remove: method: DELETE
}

# "Domain LiveDNS Information" and "Enable LiveDNS".
guide: entity: domain_livedns: path: "/domain/domains/{domain}/livedns": {
  op: load: method: GET
  op: create: method: POST
}

# DNSSEC on LiveDNS: status, activate, disable.
guide: entity: domain_dnssec: path: "/domain/domains/{domain}/livedns/dnssec": {
  op: load: method: GET
  op: create: method: POST
  op: remove: method: DELETE
}

# Change of owner: start it, follow it, resend the FOA emails.
guide: entity: domain_change_owner: path: "/domain/changeowner/{domain}": {
  op: create: method: POST
  op: load: method: GET
}
guide: entity: domain_change_owner: path: "/domain/changeowner/{domain}/foa": {
  action: foa: {}
  op: create: method: POST
}

# Transfer in: start it, follow it, relaunch it, and its verbs.
guide: entity: domain_transfer: path: "/domain/transferin": op: create: method: POST
guide: entity: domain_transfer: path: "/domain/transferin/{domain}": {
  op: load: method: GET
  op: update: method: PUT
}
guide: entity: domain_transfer: path: "/domain/transferin/{domain}/authinfo": {
