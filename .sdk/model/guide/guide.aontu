guide: entity: livedns_axfr_slave: path: "/livedns/domains/{fqdn}/axfr/slaves": op: list: method: GET
guide: entity: livedns_axfr_slave: path: "/livedns/domains/{fqdn}/axfr/slaves/{ip}": {
  op: update: method: PUT
  op: remove: method: DELETE
}
guide: entity: livedns_tsig_key: path: "/livedns/axfr/tsig": {
