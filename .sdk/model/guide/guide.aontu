  op: create: method: POST
}


# LIVEDNS. A domain on LiveDNS is named by its `fqdn`.
guide: entity: livedns_domain: path: "/livedns/domains": {
  op: list: method: GET
  op: create: method: POST
}
guide: entity: livedns_domain: path: "/livedns/domains/{fqdn}": {
  op: load: method: GET
  op: patch: method: PATCH
}

# "Replace the whole zone with new records" and "Delete all records" are
# the zone's own entity, so that a record update or remove that lacks a name
# or type can never reach them, and its name says what they do. As actions on
# the domain, the SDK sent "Delete all records" for a plain
# `LivednsDomain().remove({ fqdn })`: an operation whose only route is an
# action is chosen without the action (sdkgen 4.44.2).
guide: entity: livedns_zone: path: "/livedns/domains/{fqdn}/records": {
  op: update: method: PUT
  op: remove: method: DELETE
}

# Records (RRsets), named by `rrset_name` and `rrset_type`. The routes that
# act on every record of one name are the action `name`.
guide: entity: livedns_record: path: "/livedns/domains/{fqdn}/records": {
  op: list: method: GET
  op: create: method: POST
}
guide: entity: livedns_record: path: "/livedns/domains/{fqdn}/records/{rrset_name}": {
  action: name: {}
  op: list: method: GET
  op: create: method: POST
  op: update: method: PUT
  op: remove: method: DELETE
}
guide: entity: livedns_record: path: "/livedns/domains/{fqdn}/records/{rrset_name}/{rrset_type}": {
  op: load: method: GET
  op: create: method: POST
  op: update: method: PUT
  op: patch: method: PATCH
  op: remove: method: DELETE
}
guide: entity: livedns_record: path: "/livedns/domains/{fqdn}/verification/{rrset_name}/{rrset_type}": {
  action: verification: {}
  op: create: method: POST
}

# DNSSEC keys on LiveDNS. Patch is "Undelete a key".
guide: entity: livedns_key: path: "/livedns/domains/{fqdn}/keys": {
  op: list: method: GET
  op: create: method: POST
}
guide: entity: livedns_key: path: "/livedns/domains/{fqdn}/keys/{id}": {
  op: load: method: GET
  op: patch: method: PATCH
  op: remove: method: DELETE
}

# Zone snapshots.
guide: entity: livedns_snapshot: path: "/livedns/domains/{fqdn}/snapshots": {
  op: list: method: GET
  op: create: method: POST
}
guide: entity: livedns_snapshot: path: "/livedns/domains/{fqdn}/snapshots/{id}": {
  op: load: method: GET
  op: patch: method: PATCH
  op: remove: method: DELETE
}

# The domain's nameservers, and the generic (hashed) nameservers Gandi would
# give it: lists of host names.
guide: entity: livedns_nameserver: path: "/livedns/domains/{fqdn}/nameservers": op: list: method: GET
guide: entity: livedns_nameserver: path: "/livedns/nameservers/{fqdn}": {
  action: generic: {}
  op: list: method: GET
}

# Zone transfer (AXFR): secondary servers by IP address, TSIG keys, and the
