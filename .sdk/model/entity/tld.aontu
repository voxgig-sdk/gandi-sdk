# Entity: tld

main: kit: entity: tld: {

  alias: field: {}

  fields: {
    authinfo_for_transfer: {
      h: "Authinfo For Transfer"
      n: "authinfo_for_transfer"
      r: true
      t: "`$BOOLEAN`"
    }
    category: {
      h: "Category"
      n: "category"
      r: true
      t: "`$STRING`"
    }
    change_owner: {
      h: "Change Owner"
      n: "change_owner"
      r: true
      t: "`$BOOLEAN`"
    }
    corporate: {
      h: "Corporate"
      n: "corporate"
      r: true
      t: "`$BOOLEAN`"
    }
    ext_trade: {
      h: "Ext Trade"
      n: "ext_trade"
      r: true
      t: "`$BOOLEAN`"
    }
    full_tld: {
      h: "Full Tld"
      n: "full_tld"
      r: true
      t: "`$STRING`"
    }
    href: {
      h: "Href"
      n: "href"
      r: true
      t: "`$STRING`"
    }
    lock: {
      h: "Lock"
      n: "lock"
      r: true
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      t: "`$STRING`"
    }
  }

  name: "tld"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /domain/tlds"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                explode: true
                k: "query"
                n: "category"
                or: "category"
                r: false
                style: "form"
                t: "`$STRING`"
              }
              {
                ex: 1
                explode: true
                k: "query"
                n: "page"
                or: "page"
                r: false
                style: "form"
                t: "`$INTEGER`"
              }
              {
                explode: true
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                style: "form"
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/domain/tlds"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "domain"
            }
            {
              lit: "tlds"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /domain/tlds/{name}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "name"
                or: "name"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/domain/tlds/{name}"
          q: {
            exist: [
              "name"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "domain"
            }
            {
              lit: "tlds"
            }
            {
              var: "name"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
