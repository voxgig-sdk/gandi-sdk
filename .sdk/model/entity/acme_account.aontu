                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                explode: true
                k: "query"
                n: "sharing_id"
                or: "sharing_id"
                r: true
                style: "form"
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/acme/subscriptions/{subscription_id}/accounts/{account_id}"
          q: {
            exist: [
              "id"
              "sharing_id"
              "subscription_id"
            ]
          }
          r: {
            param: {
              account_id: "id"
            }
