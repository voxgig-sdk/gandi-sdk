# BasicMailboxFlow

main: kit: flow: BasicMailboxFlow:
{
  entity: "mailbox",
  kind: "basic",
  name: "BasicMailboxFlow",
  step: [
    {
      i: {
        ref: "mailbox_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "mailbox_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "mailbox_ref01",
        srcdatavar: "mailbox_ref01_data",
        suffix: "_up0",
        textfield: "config_name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-mailbox_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "mailbox_ref01",
        srcdatavar: "mailbox_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "mailbox01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-mailbox_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "mailbox_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "mailbox01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "mailbox_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMailboxFlow"
}