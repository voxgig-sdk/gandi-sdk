# BasicMailboxForwardFlow

main: kit: flow: BasicMailboxForwardFlow:
{
  entity: "mailbox_forward",
  kind: "basic",
  name: "BasicMailboxForwardFlow",
  step: [
    {
      i: {
        ref: "mailbox_forward_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "mailbox_forward_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "mailbox_forward_ref01",
        srcdatavar: "mailbox_forward_ref01_data",
        suffix: "_up0",
        textfield: "message"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-mailbox_forward_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "mailbox_forward_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "mailbox_forward01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "mailbox_forward_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMailboxForwardFlow"
}