# BasicDomainContactFlow

main: kit: flow: BasicDomainContactFlow:
{
  entity: "domain_contact",
  kind: "basic",
  name: "BasicDomainContactFlow",
  step: [
    {
      i: {
        ref: "domain_contact_ref01",
        srcdatavar: "domain_contact_ref01_data",
        suffix: "_up0",
        textfield: "message"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-domain_contact_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "domain_contact_ref01",
        srcdatavar: "domain_contact_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "domain_contact01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-domain_contact_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDomainContactFlow"
}