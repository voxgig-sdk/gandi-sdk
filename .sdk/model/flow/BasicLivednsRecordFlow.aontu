# BasicLivednsRecordFlow

main: kit: flow: BasicLivednsRecordFlow:
{
  entity: "livedns_record",
  kind: "basic",
  name: "BasicLivednsRecordFlow",
  step: [
    {
      i: {
        ref: "livedns_record_ref01"
      }

      m: {
        fqdn: "fqdn01",
        rrset_name: "rrset_name01"
      }

      o: "create"
    }

    {
      m: {
        fqdn: "fqdn01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "livedns_record_ref01"
          }
        }
      ]
    }

    {
      d: {
        fqdn: "fqdn01"
      }

      i: {
        ref: "livedns_record_ref01",
        srcdatavar: "livedns_record_ref01_data",
        suffix: "_up0",
        textfield: "message"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-livedns_record_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "livedns_record_ref01",
        srcdatavar: "livedns_record_ref01_data",
        suffix: "_dt0"
      }

      m: {
        fqdn: "fqdn01",
        id: "livedns_record01",
        rrset_name: "rrset_name01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-livedns_record_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "livedns_record_ref01",
        suffix: "_rm0"
      }

      m: {
        fqdn: "fqdn01",
        id: "livedns_record01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        fqdn: "fqdn01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "livedns_record_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLivednsRecordFlow"
}