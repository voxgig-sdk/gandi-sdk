    {
      i: {
        ref: "domain_livedns_ref01",
        srcdatavar: "domain_livedns_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "domain_livedns01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
