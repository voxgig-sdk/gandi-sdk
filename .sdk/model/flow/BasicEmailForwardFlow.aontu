# BasicEmailForwardFlow

main: kit: flow: BasicEmailForwardFlow:
{
  entity: "email_forward",
  kind: "basic",
  name: "BasicEmailForwardFlow",
  step: [
    {
      i: {
        ref: "email_forward_ref01"
      }

      m: {
        domain: "domain01"
      }

      o: "create"
    }

    {
      m: {
        domain: "domain01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "email_forward_ref01"
          }
        }
      ]
    }

    {
      d: {
        domain: "domain01"
      }

      i: {
        ref: "email_forward_ref01",
        srcdatavar: "email_forward_ref01_data",
        suffix: "_up0",
        textfield: "href"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-email_forward_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "email_forward_ref01",
        suffix: "_rm0"
      }

      m: {
        domain: "domain01",
        id: "email_forward01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        domain: "domain01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "email_forward_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEmailForwardFlow"
}