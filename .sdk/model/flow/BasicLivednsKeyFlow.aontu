# BasicLivednsKeyFlow

main: kit: flow: BasicLivednsKeyFlow:
{
  entity: "livedns_key",
  kind: "basic",
  name: "BasicLivednsKeyFlow",
  step: [
    {
      i: {
        ref: "livedns_key_ref01"
      }

      m: {
        fqdn: "fqdn01"
      }

      o: "create"
    }

    {
      m: {
        fqdn: "fqdn01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "livedns_key_ref01"
          }
        }
      ]
    }

    {
      d: {
        fqdn: "fqdn01"
      }

      i: {
        ref: "livedns_key_ref01",
        srcdatavar: "livedns_key_ref01_data",
        suffix: "_up0",
        textfield: "algorithm_name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-livedns_key_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "livedns_key_ref01",
        srcdatavar: "livedns_key_ref01_data",
        suffix: "_dt0"
      }

      m: {
        fqdn: "fqdn01",
        id: "livedns_key01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-livedns_key_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "livedns_key_ref01",
        suffix: "_rm0"
      }

      m: {
        fqdn: "fqdn01",
        id: "livedns_key01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        fqdn: "fqdn01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "livedns_key_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLivednsKeyFlow"
}