# BasicIssuedCertificateFlow

main: kit: flow: BasicIssuedCertificateFlow:
{
  entity: "issued_certificate",
  kind: "basic",
  name: "BasicIssuedCertificateFlow",
  step: [
    {
      i: {
        ref: "issued_certificate_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "issued_certificate_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "issued_certificate_ref01",
        srcdatavar: "issued_certificate_ref01_data",
        suffix: "_up0",
        textfield: "assumed_name"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-issued_certificate_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "issued_certificate_ref01",
        srcdatavar: "issued_certificate_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "issued_certificate01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-issued_certificate_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "issued_certificate_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "issued_certificate01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "issued_certificate_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIssuedCertificateFlow"
}