# BasicDomainHostFlow

main: kit: flow: BasicDomainHostFlow:
{
  entity: "domain_host",
  kind: "basic",
  name: "BasicDomainHostFlow",
  step: [
    {
      i: {
        ref: "domain_host_ref01"
      }

      m: {
        domain: "domain01"
      }

      o: "create"
    }

    {
      m: {
        domain: "domain01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "domain_host_ref01"
          }
        }
      ]
    }

    {
      d: {
        domain: "domain01"
      }

      i: {
        ref: "domain_host_ref01",
        srcdatavar: "domain_host_ref01_data",
        suffix: "_up0",
        textfield: "fqdn"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-domain_host_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "domain_host_ref01",
        srcdatavar: "domain_host_ref01_data",
        suffix: "_dt0"
      }

      m: {
        domain: "domain01",
        id: "domain_host01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-domain_host_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "domain_host_ref01",
        suffix: "_rm0"
      }

      m: {
        domain: "domain01",
        id: "domain_host01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        domain: "domain01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "domain_host_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDomainHostFlow"
}