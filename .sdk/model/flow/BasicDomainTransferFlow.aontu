# BasicDomainTransferFlow

main: kit: flow: BasicDomainTransferFlow:
{
  entity: "domain_transfer",
  kind: "basic",
  name: "BasicDomainTransferFlow",
  step: [
    {
      i: {
        ref: "domain_transfer_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "domain_transfer_ref01",
        srcdatavar: "domain_transfer_ref01_data",
        suffix: "_up0",
        textfield: "authinfo"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-domain_transfer_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "domain_transfer_ref01",
        srcdatavar: "domain_transfer_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "domain_transfer01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-domain_transfer_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDomainTransferFlow"
}