# BasicCertificatePackageFlow

main: kit: flow: BasicCertificatePackageFlow:
{
  entity: "certificate_package",
  kind: "basic",
  name: "BasicCertificatePackageFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "certificate_package_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "certificate_package_ref01",
        srcdatavar: "certificate_package_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "certificate_package01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-certificate_package_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCertificatePackageFlow"
}