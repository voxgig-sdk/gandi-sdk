# BasicDomainTagFlow

main: kit: flow: BasicDomainTagFlow:
{
  entity: "domain_tag",
  kind: "basic",
  name: "BasicDomainTagFlow",
  step: [
    {
      i: {
        ref: "domain_tag_ref01"
      }

      m: {
        domain: "domain01"
      }

      o: "create"
    }

    {
      m: {
        domain: "domain01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "domain_tag_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "domain_tag_ref01",
        srcdatavar: "domain_tag_ref01_data",
        suffix: "_up0",
        textfield: "message"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-domain_tag_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "domain_tag_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "domain_tag01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        domain: "domain01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "domain_tag_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDomainTagFlow"
}