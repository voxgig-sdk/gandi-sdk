# BasicAcmeFlow

main: kit: flow: BasicAcmeFlow:
{
  entity: "acme",
  kind: "basic",
  name: "BasicAcmeFlow",
  step: [
    {
      i: {
        ref: "acme_ref01"
      }

      m: {
        subscription_id: "subscription01"
      }

      o: "create"
    }

    {
      m: {
        subscription_id: "subscription01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "acme_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "acme_ref01",
        srcdatavar: "acme_ref01_data",
        suffix: "_up0",
        textfield: "country"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-acme_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "acme_ref01",
        srcdatavar: "acme_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "acme01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-acme_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "acme_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "acme01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        subscription_id: "subscription01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "acme_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAcmeFlow"
}