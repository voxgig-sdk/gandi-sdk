# BasicEmailMigrationFlow

main: kit: flow: BasicEmailMigrationFlow:
{
  entity: "email_migration",
  kind: "basic",
  name: "BasicEmailMigrationFlow",
  step: [
    {
      i: {
        ref: "email_migration_ref01"
      }

      m: {
        domain: "domain01"
      }

      o: "create"
    }

    {
      i: {
        ref: "email_migration_ref01",
        srcdatavar: "email_migration_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "email_migration01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-email_migration_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEmailMigrationFlow"
}