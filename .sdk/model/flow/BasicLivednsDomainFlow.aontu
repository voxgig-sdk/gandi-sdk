            ref: "livedns_domain_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "livedns_domain_ref01",
        srcdatavar: "livedns_domain_ref01_data",
        suffix: "_up0",
        textfield: "domain_href"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-livedns_domain_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "livedns_domain_ref01",
        srcdatavar: "livedns_domain_ref01_data",
